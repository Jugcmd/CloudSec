        },
        "filter": {
          "dimensions": {
            "name": "ResourceGroupName",
            "operator": "In",
            "values": ["[resourceGroup().name]"]
          }
        },
        "notifications": {
          "atEightyPercent": {
            "enabled": true,
            "operator": "GreaterThan",
            "threshold": 80,
            "contactEmails": [],
            "thresholdType": "Actual"
          },
          "atOneHundredPercent": {
            "enabled": true,
            "operator": "GreaterThan",
            "threshold": 100,
            "contactEmails": [],
            "thresholdType": "Actual"
          }
        }
      }
    }
